# Static dev server config — copy to .env and fill values

# Base URL of the running Strapi instance (no trailing slash)
# Local dev:   http://localhost:1337
# Production:  https://your-strapi.cloud.example.com
STRAPI_URL=http://localhost:1337

# API token from Strapi Admin → Settings → API Tokens (Read-only access to Product is enough)
STRAPI_API_TOKEN=

# Optional — port for the static dev server (default 3000)
# PORT=3000